<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="basic_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import basic_robot urdf file -->
    <xacro:include filename="$(find ros2_moveit_description_template)/urdf/arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="basic_robot.ros2_control.xacro" />


    <xacro:basic_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
